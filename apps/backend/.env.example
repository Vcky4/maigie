# Application Configuration
APP_NAME=Maigie API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/api/v1

# CORS Configuration
# Use JSON array format for list fields
CORS_ORIGINS=["http://localhost:4200","http://localhost:5173","http://localhost:3000", "https://maigie.com", "https://dev.maigie.com","https://www.maigie.com", "https://app.maigie.com", "http://localhost:4201", "https://admin.maigie.com", "https://dev-admin.maigie.com"]
CORS_ALLOW_CREDENTIALS=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Append ?connection_limit=20 for production with concurrent WebSocket + Celery workers
DATABASE_URL=postgresql://user:password@localhost:5432/maigie

# Redis (for future use)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# WebSocket
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_HEARTBEAT_TIMEOUT=120
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=maigie:
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Auto-generated from REDIS_URL
CELERY_BROKER_URL=redis://localhost:6379/1      # Broker (DB 1)
CELERY_RESULT_BACKEND=redis://localhost:6379/2  # Results (DB 2)

# Task settings
CELERY_TASK_ALWAYS_EAGER=false  # Set true for testing (runs synchronously)
CELERY_TIMEZONE=UTC

# Worker concurrency (number of child processes)
# Production: 3 (good balance for 300 users on 12GB RAM)
# Staging: 1 (minimal resource usage)
# Development: 1 or use CELERY_TASK_ALWAYS_EAGER=true to skip workers entirely
CELERY_CONCURRENCY=1

SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1

# OAuth Configuration
OAUTH_GOOGLE_CLIENT_ID="<Your Google Client ID>"
OAUTH_GOOGLE_CLIENT_SECRET="<Your Google Client Secret>"

#smtp Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="hello@maigie.com"
EMAILS_FROM_NAME="Maigie"

# Resend fallback when primary SMTP fails (e.g. Brevo monthly quota). Optional RESEND_FROM_EMAIL must be verified in Resend.
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL="hello@maigie.com"
# When Brevo quota is exceeded, set resend_then_smtp or resend_only (SMTP cannot detect silent drops).
EMAIL_OUTBOUND_STRATEGY=smtp_then_resend

FRONTEND_BASE_URL="https://maigie.com" 

#bravo
BREVO_API_KEY=your-api-key-here
BREVO_ENABLED=true

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_DESTINATION_ID=""
# Maigie Plus subscription, $4.99/mo, 3-day trial on first purchase.
# The Stripe price's own trial_period_days must also read 3 — set it in the dashboard.
STRIPE_PRICE_ID_MONTHLY=""
# Plus passes: one-time prices (mode: payment), $0.99 and $2.49. Not subscriptions.
STRIPE_PRICE_ID_PLUS_PASS_5H=""
STRIPE_PRICE_ID_PLUS_PASS_7D=""
# WITHDRAWN products. These price ids are set only so a renewal or refund webhook for a
# grandfathered subscriber can still be matched to its source tier. Nothing may be sold
# against them: the checkout answers 410.
STRIPE_PRICE_ID_YEARLY=""
STRIPE_PRICE_ID_STUDY_CIRCLE_MONTHLY=""
STRIPE_PRICE_ID_STUDY_CIRCLE_YEARLY=""
STRIPE_PRICE_ID_SQUAD_MONTHLY=""
STRIPE_PRICE_ID_SQUAD_YEARLY=""
FRONTEND_URL=http://localhost:4200

# Paystack (Nigeria - NGN). Webhook signature uses PAYSTACK_SECRET_KEY.
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
# Create plans in Paystack Dashboard, copy plan codes (e.g. PLN_xxx)
PAYSTACK_PLAN_MAIGIE_PLUS_MONTHLY=
PAYSTACK_PLAN_MAIGIE_PLUS_YEARLY=
PAYSTACK_PLAN_STUDY_CIRCLE_MONTHLY=
PAYSTACK_PLAN_STUDY_CIRCLE_YEARLY=
PAYSTACK_PLAN_SQUAD_MONTHLY=
PAYSTACK_PLAN_SQUAD_YEARLY=

EMAIL_LOGO_URL="https://maigie.com/assets/logo.png"

#bunny cdn
BUNNY_CDN_API_KEY= None
BUNNY_STORAGE_ZONE= None
BUNNY_CDN_HOSTNAME="cdn.maigie.com"
# Optional: public base with valid TLS if custom CDN hostname cert is broken, e.g. https://yourzone.b-cdn.net
BUNNY_PUBLIC_URL_BASE="https://maigie.b-cdn.net"

GEMINI_API_KEY="yijk"
# One comma-separated list for Gemini exam prep, schedule AI, etc. (round-robin on retry). Optional overrides: GEMINI_EXAM_PREP_MODELS, GEMINI_SCHEDULE_AI_MODELS.
GEMINI_ROTATING_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# --- Multi-Provider LLM Configuration ---
# Provider API keys (leave empty to disable a provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default models per provider
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Circuit Breaker — trips after N failures within the rolling window, then cools down
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
CIRCUIT_BREAKER_ROLLING_WINDOW_SECONDS=60.0

# Retry — max attempts and exponential backoff base delay
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# Router timeout — max seconds for the entire route_request pipeline (selection + all fallback attempts)
LLM_ROUTER_TIMEOUT_SECONDS=90.0
# Per-adapter timeout — max seconds for a single provider call before falling back to next
LLM_ADAPTER_TIMEOUT_SECONDS=60.0

# Fallback chains — comma-separated provider:model pairs tried in order on failure
FALLBACK_CHAT_DEFAULT=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,openai:gpt-4o-mini,anthropic:claude-sonnet-4-20250514
FALLBACK_CHAT_TOOLS=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,openai:gpt-4o,anthropic:claude-sonnet-4-20250514

# Feature flags — which providers are enabled (comma-separated). Add "openai" or "anthropic" to enable fallback.
LLM_ENABLED_PROVIDERS=gemini,openai

# Tier-based model allowlists — comma-separated provider:model pairs each tier can access.
# Only ``free`` and ``plus`` exist after Circle Reimagining; Circle-scoped AI
# capabilities resolve to one of these two via Seat_Tier.
LLM_TIER_ALLOWLIST_FREE=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite
LLM_TIER_ALLOWLIST_PLUS=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,openai:gpt-4o-mini

# Gemini Live (voice) — optional; defaults match Settings in config.py
# GEMINI_LIVE_MODEL=
# GEMINI_LIVE_GREETING_PROMPT=
# GEMINI_LIVE_CREDITS_PER_MINUTE=100
# GEMINI_LIVE_MIN_SESSION_CREDITS=500

# Celery schedule-AI batch cap (users processed per daily run)
# AI_SCHEDULE_REVIEW_MAX_USERS=500

# ElevenLabs (Smart AI Tutor, Exam Prep voice, Conversational AI agent)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_AGENT_ID=

# Firebase Cloud Messaging (Push Notifications)
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option 2: Service account JSON content (for Docker/env-based deploys)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Notification external-channel and intelligence kill switches.
# Not-yet-implemented paths stay off; each rollout uses the same stable user cohort rules.
# EMAIL is implemented and its sender is on, but empty allowlists plus a 0% rollout mean no
# user is eligible until a cohort is approved. Add a user id to the internal allowlist to
# validate with a real person without exposing anyone else.
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_DENYLIST=[]
NOTIFICATION_EMAIL_ALLOWLIST=[]
NOTIFICATION_EMAIL_INTERNAL_ALLOWLIST=[]
NOTIFICATION_EMAIL_ROLLOUT_PERCENT=0
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_BATCH=50
# Public origin of this API. Used for the one-click unsubscribe URL written into email headers
# by a background worker, which has no request to derive an origin from.
PUBLIC_API_BASE_URL=https://staging-api.maigie.com
# Resend webhook signing secret. Empty refuses webhook ingestion instead of trusting it.
RESEND_WEBHOOK_SECRET=
WEB_PUSH_ENABLED=false
WEB_PUSH_DENYLIST=[]
WEB_PUSH_ALLOWLIST=[]
WEB_PUSH_INTERNAL_ALLOWLIST=[]
WEB_PUSH_ROLLOUT_PERCENT=0
NOTIFICATION_INTELLIGENCE_ENABLED=false
NOTIFICATION_INTELLIGENCE_DENYLIST=[]
NOTIFICATION_INTELLIGENCE_ALLOWLIST=[]
NOTIFICATION_INTELLIGENCE_INTERNAL_ALLOWLIST=[]
NOTIFICATION_INTELLIGENCE_ROLLOUT_PERCENT=0
NOTIFICATION_INTELLIGENCE_SHADOW_ONLY=true

# Expo mobile push defaults. The sender stays enabled, while empty allowlists and
# a 0% rollout keep users ineligible until an explicitly approved staged rollout.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push
EXPO_ACCESS_TOKEN=
MOBILE_PUSH_ENABLED=true
# Stable user IDs as JSON arrays. Deny wins; allow/internal bypass percentage.
MOBILE_PUSH_DENYLIST=[]
MOBILE_PUSH_ALLOWLIST=[]
MOBILE_PUSH_INTERNAL_ALLOWLIST=[]
MOBILE_PUSH_ROLLOUT_PERCENT=0
MOBILE_PUSH_MAX_ATTEMPTS=5
MOBILE_PUSH_RECEIPT_DELAY_SECONDS=900
MOBILE_PUSH_STALE_SENDING_SECONDS=600
