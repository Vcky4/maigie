// ===========================================================================
// BASE — Datasource, generator configuration, and shared enums.
// All .prisma files in this directory are automatically merged by Prisma.
// ===========================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
  previewFeatures             = ["prismaSchemaFolder"]
}

