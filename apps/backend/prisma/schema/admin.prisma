// ===========================================================================
// ADMIN DOMAIN — Feedback, CMS, Audit, Ledger, System Config
// ===========================================================================
// ==========================================
//  FEEDBACK MODULE
// ==========================================

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL_FEEDBACK
  UI_UX_FEEDBACK
  PERFORMANCE_ISSUE
  OTHER
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
  ARCHIVED
}

enum CareerApplicationStatus {
  NEW
  REVIEWED
  ARCHIVED
}

model Feedback {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Feedback content
  type        FeedbackType
  title       String
  description String
  status      FeedbackStatus @default(PENDING)

  // Optional context
  pageUrl   String? // URL where feedback was submitted from
  userAgent String? // Browser/device info
  metadata  Json? // Additional context (e.g., screenshots, logs)

  // Admin response
  adminNotes String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model CareerApplication {
  id String @id @default(cuid())

  jobId    String
  jobTitle String

  firstName    String
  lastName     String
  email        String
  linkedinUrl  String
  portfolioUrl String?

  coverLetter String @db.Text

  status     CareerApplicationStatus @default(NEW)
  adminNotes String?

  userAgent String?
  sourceIp  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// ==========================================
//  MARKETING CMS (blog + careers), managed in admin
// ==========================================

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  content     String   @db.Text
  authorName  String
  authorRole  String?
  publishedAt DateTime
  tags        String[]
  category    String
  coverImage  String?
  readTime    Int?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}

/// Content calendar for scheduling AI-generated blog posts
model ContentCalendarEntry {
  id            String   @id @default(uuid())
  topic         String // Blog topic / working title
  keywords      String[] // SEO keywords
  category      String   @default("Study Tips")
  scheduledDate DateTime // Target publish date
  status        String   @default("scheduled") // scheduled, generating, published, failed, draft
  blogPostId    String? // Created BlogPost ID (set after generation)
  coverImageUrl String? // Uploaded cover image CDN URL
  notes         String? // Admin notes
  autoPublish   Boolean  @default(true) // Auto-publish or create as draft for review
  errorMessage  String? // Error details if status=failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, scheduledDate])
  @@index([scheduledDate])
}

model JobPosting {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  title                  String
  location               String
  type                   String
  stage                  String
  description            String   @db.Text
  responsibilities       String[]
  requirementsMustHave   String[]
  requirementsNiceToHave String[]
  successMetrics         String[]
  whyRoleMatters         String[]
  compensation           String[]
  published              Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

// ==========================================
// ==========================================
//  AUDIT LOG MODULE
// ==========================================

model AuditLog {
  id String @id @default(uuid())

  adminUserId String // ID of admin user who performed the action
  adminUser   User?  @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  actionType   String // e.g., "create_user", "delete_course", "adjust_credits"
  resourceType String // e.g., "user", "course", "subscription"
  resourceId   String? // ID of the resource affected (optional)

  details Json? // Additional details about the action (JSON object)

  timestamp DateTime @default(now())

  @@index([adminUserId])
  @@index([actionType])
  @@index([resourceType])
  @@index([timestamp])
  @@index([resourceType, resourceId])
}

/// Super-admin ledger: income and expenses with original currency and GBP equivalent.
model LedgerLine {
  id          String         @id @default(cuid())
  kind        LedgerLineKind
  title       String
  description String?

  /// Amount in `currency` (original).
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  /// Sterling equivalent for reporting (auto or manual).
  amountGbp Decimal @db.Decimal(18, 4)

  /// Multiply `amount` by this to get `amountGbp` (1.0 when currency is GBP).
  gbpPerUnit Decimal? @db.Decimal(18, 10)

  /// FX quote date (YYYY-MM-DD) when `fxSource` is frankfurter.
  fxAsOfDate String? @db.VarChar(10)
  fxSource   String  @db.VarChar(32) // frankfurter | identity | manual

  occurredAt DateTime

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, occurredAt])
  @@index([occurredAt])
}

// ==========================================
//  SYSTEM CONFIGURATION (Admin-editable)
// ==========================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON-encoded value
  category  String   @default("general") // "llm", "general", "billing", etc.
  label     String?  // Human-readable label for admin UI
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

