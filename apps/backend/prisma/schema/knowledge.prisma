// ==========================================
//  COURSES MODULE
// ==========================================

model Course {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  difficulty    Difficulty @default(BEGINNER)
  targetDate    DateTime?
  isAIGenerated Boolean    @default(false)
  archived      Boolean    @default(false)

  // Cached progress (0.0 to 100.0) â€” per-user even in circles
  progress Float @default(0.0)

  // Circle: if set, this course is shared within a circle (progress tracked per-user)
  circleId String?
  circle   Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules       Module[]
  notes         Note[]
  resources     Resource[] // Resources linked to this course
  goals         Goal[] // Goals linked to this course
  schedules     ScheduleBlock[] // Schedule blocks linked to this course
  studySessions StudySession[] // Study sessions for this course
  chatSessions  ChatSession[]

  outlineSatisfactions CourseOutlineSatisfaction[]
  groupLinks           CircleGroupCourseLink[]

  @@index([userId])
  @@index([userId, archived])
  @@index([circleId])
}

model CourseOutlineSatisfaction {
  id       String                        @id @default(cuid())
  userId   String
  courseId String
  kind     CourseOutlineSatisfactionKind
  /// Optional detail when kind is NOT_SATISFIED or MODIFICATION_REQUESTED
  feedback String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId, courseId])
  @@index([userId, createdAt])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Float   @default(0)
  completed   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@index([courseId])
  @@index([courseId, order])
}

model Topic {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title          String
  content        String? // Markdown content
  order          Float   @default(0)
  completed      Boolean @default(false)
  estimatedHours Float?

  notes         Note[]
  resources     Resource[] // Resources linked to this topic
  goals         Goal[] // Goals linked to this topic
  schedules     ScheduleBlock[] // Schedule blocks linked to this topic
  studySessions StudySession[] // Study sessions for this topic
  reviewItems   ReviewItem[] // Spaced repetition: one review schedule per completed topic
  groupSessions CircleSession[] // Group sessions linked to this topic

  // Per-user progress tracking (used for Circle courses where multiple users share the same topic)
  userProgress UserTopicProgress[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatSessions ChatSession[]

  @@index([moduleId])
  @@index([moduleId, order])
}

// Per-user progress for shared Circle courses.
// For personal courses, Topic.completed is still used (backward compat).
// For Circle courses, this table is the source of truth for each member's progress.
model UserTopicProgress {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  completed   Boolean  @default(false)
  completedAt DateTime?
  // Time spent studying this topic (minutes)
  minutesSpent Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([userId, completed])
}

